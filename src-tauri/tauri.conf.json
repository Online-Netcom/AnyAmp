{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnyAmp!",
  "version": "0.0.6",
  "identifier": "com.anyamp.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AnyAmp!",
        "width": 550,
        "height": 696,
        "resizable": false,
        "decorations": false,
        "shadow": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5ODRGMjk1MzU3QTlEMDEKUldRQm5YbzFsZktFV1ZsVW4wNm00ZFJOdWpheTVYK2sydy8yWUlQUzE2bHpLYTRySGlub21zWEQK",
      "endpoints": [
        "https://github.com/Online-Netcom/AnyAmp/releases/latest/download/latest.json"
      ]
    }
  }
}
